# Copy to .env and fill in values. Never commit .env.

# --- Required secrets ---
# Persistent master key: encrypts per-unit SSH private keys at rest.
# Generate a long random string and keep a durable copy; it is NOT stored in backups.
CC_MASTER_KEY='<generate-a-long-random-string>'

# Admin password (min 8 chars). If set, seeds the password on an empty database.
# Leave unset to use CC_BOOTSTRAP_TOKEN with the first-run setup form instead.
CC_ADMIN_PASSWORD=''

# One-time first-run token (min 8 chars), used when CC_ADMIN_PASSWORD is unset.
# Consumed after the admin password is set.
CC_BOOTSTRAP_TOKEN=''

# --- Network ---
PORT=3030
HOST=0.0.0.0
# Restrict the authorized key on units to this source address (optional).
# CC_PUBLIC_IP='<this-host-public-ip>'

# --- Paths ---
# Absolute paths are required for compiled-binary / container deployments.
# CC_DATA='<DATA_DIR>'
# CC_WEB='<INSTALL_DIR>/apps/web/dist'
# CC_AGENT_DIR='<INSTALL_DIR>/agent'

# --- Polling ---
# Initial poll interval in seconds (editable in Settings).
CC_POLL_INTERVAL=5

# --- Agent installer ---
# Public agent repository in owner/name form and release tag for the short installer.
# CC_AGENT_REPO='<AGENT_REPO>'
CC_AGENT_TAG=latest

# --- Runtime behavior ---
NODE_ENV=production
# Local development only: built-in dev master key and loopback setup. Never enable in production.
# CC_DEV_KEY=1
# Disable starting the poller (useful for tests / seeding).
# CC_NO_POLL=1
