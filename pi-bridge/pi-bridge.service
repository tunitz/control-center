[Unit]
Description=pi-bridge (Control Center <-> Pi RPC bridge)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/projects/control-center/pi-bridge
ExecStart=%h/.bun/bin/bun run src/index.ts
EnvironmentFile=%h/.local/share/cc-pi/env
Environment=PI_BRIDGE_PORT=3050
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
