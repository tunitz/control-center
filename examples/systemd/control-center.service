[Unit]
Description=Control Center
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h/control-center
EnvironmentFile=%h/control-center/.env
Environment=PATH=%h/.bun/bin:/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin
Environment=CC_DATA=%h/control-center/data
Environment=CC_WEB=%h/control-center/apps/web/dist
Environment=CC_AGENT_DIR=%h/control-center/agent
ExecStart=%h/control-center/dist/control-center
Restart=on-failure
RestartSec=2
TimeoutStopSec=20

[Install]
WantedBy=default.target
