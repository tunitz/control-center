# Docker build context: only what `docker build` needs. Everything excluded here
# is regenerated inside the image or is never read by the running service.

# Secrets and credentials
.env
.env.*
**/.env
**/.env.*
.npmrc
**/.npmrc
*.pem
*.p12
*.pfx
*.key

# Version control
.git
**/.git

# Dependencies (installed fresh inside the image)
node_modules
**/node_modules

# Local runtime state: SQLite plus WAL/SHM sidecars
data
**/data
*.db*
**/*.db*

# Build outputs (rebuilt in the image; root dist/ is a release artifact)
dist
**/dist

# Disposable task and test artifacts
scratch
**/scratch
.playwright-cli/
**/.playwright-cli/
coverage/
**/coverage/
.nyc_output/
**/.nyc_output/
*.log

# Tests and test-only fixtures (not production inputs)
apps/server/src/*.test.ts
apps/server/src/**/*.test.ts
apps/web/src/*.test.ts
apps/web/src/**/*.test.ts
apps/**/src/**/fixtures
apps/**/src/**/__fixtures__

# Dev, release and test tooling (not a build or runtime input)
tools/
examples/

# Generated bytecode
__pycache__
**/__pycache__
*.pyc

# Docs and agent skill definitions (not needed to build or run the image)
docs/
.claude/
README.md
AGENTS.md
CLAUDE.md
.github/
compose*.yaml
docker-compose.yml
Dockerfile
release-please-config.json
.release-please-manifest.json

# Editor and OS noise
.DS_Store
Thumbs.db
*.swp
*.swo
